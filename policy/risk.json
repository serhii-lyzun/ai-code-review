{
  "$comment": "Risk tiers for merge-gate.yml, evaluated by scripts/risk-tier.mjs. Globs: * matches within one path segment, ** across segments. Rules are checked in order: high, then low, then medium as the default.",
  "high": {
    "description": "Needs one human approval (merge-gate). Paths listed in CODEOWNERS also need code-owner review (ruleset).",
    "paths": [
      ".github/**",
      ".claude/**",
      ".husky/**",
      "policy/**",
      "scripts/**",
      "CLAUDE.md",
      "REVIEW.md",
      "CODE_CONVENTIONS.md",
      "AI_CODE_REVIEW_PLAN.md",
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "*.config.*",
      ".oxlintrc.json",
      ".prettierrc*",
      ".nvmrc",
      "index.html",
      "src/test/**",
      "**/CLAUDE.md",
      "**/CLAUDE.local.md",
      "**/AGENTS.md",
      "**/.claude/**",
      "**/.mcp.json"
    ],
    "maxChangedLines": 400,
    "branchPrefixes": ["hotfix/"]
  },
  "low": {
    "description": "Can be auto-merged once every required check passes. Assets count only as raster images or fonts: SVG and HTML can carry scripts.",
    "paths": [
      "**/*.md",
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "src/assets/**/*.png",
      "src/assets/**/*.jpg",
      "src/assets/**/*.jpeg",
      "src/assets/**/*.gif",
      "src/assets/**/*.webp",
      "src/assets/**/*.avif",
      "src/assets/**/*.ico",
      "src/assets/**/*.woff",
      "src/assets/**/*.woff2",
      "public/**/*.png",
      "public/**/*.jpg",
      "public/**/*.jpeg",
      "public/**/*.gif",
      "public/**/*.webp",
      "public/**/*.avif",
      "public/**/*.ico",
      "public/**/*.woff",
      "public/**/*.woff2"
    ],
    "maxChangedLines": 100,
    "dependabot": {
      "description": "Dependabot npm updates that only touch package.json and package-lock.json.",
      "ecosystems": ["npm", "npm_and_yarn"],
      "updateTypes": [
        "version-update:semver-patch",
        "version-update:semver-minor"
      ],
      "paths": ["package.json", "package-lock.json"]
    }
  },
  "medium": {
    "description": "Everything else: needs one human approval."
  }
}
